#!/bin/sh
# rpgplay-server: comandos do servidor RPG Play (configuração em /etc/rpgplay/server.env).
# Os arquivos do servidor pertencem ao usuário "rpgplay"; com sudo, os comandos rodam como ele.
#   sudo rpgplay-server info                      endereços para conectar
#   sudo rpgplay-server reset-password <usuário>  nova senha para quem esqueceu
#   sudo rpgplay-server make-admin <usuário>
#   sudo rpgplay-server backup <arquivo.tar.gz>
#   sudo rpgplay-server restore <arquivo.tar.gz>
set -e
BIN=/opt/rpgplay-server/rpgplay-server
if [ -r /etc/rpgplay/server.env ]; then
  set -a
  . /etc/rpgplay/server.env
  set +a
fi

if [ "$(id -u)" -ne 0 ]; then
  if [ "$(id -un)" = rpgplay ]; then exec "$BIN" "$@"; fi
  echo "Use sudo: sudo rpgplay-server ${*:-info}" >&2
  exit 1
fi

as_service_user() { runuser -u rpgplay -- "$BIN" "$@"; }

case "${1:-}" in
  backup)
    target="${2:-}"
    if [ -z "$target" ] || [ "$target" = "-" ]; then exec runuser -u rpgplay -- "$BIN" backup -; fi
    as_service_user backup - > "$target"
    if [ -n "${SUDO_USER:-}" ]; then chown "$SUDO_USER": "$target" || true; fi
    echo "Backup salvo em $target"
    ;;
  restore)
    source="${2:-}"
    if [ -z "$source" ] || [ ! -r "$source" ]; then
      echo "Uso: sudo rpgplay-server restore <arquivo.tar.gz>" >&2
      exit 2
    fi
    was_running=0
    if [ -d /run/systemd/system ] && systemctl is-active --quiet rpgplay-server 2>/dev/null; then
      was_running=1
      systemctl stop rpgplay-server
    fi
    status=0
    as_service_user restore - < "$source" || status=$?
    if [ "$was_running" = 1 ]; then systemctl start rpgplay-server; fi
    exit "$status"
    ;;
  *)
    exec runuser -u rpgplay -- "$BIN" "$@"
    ;;
esac
