# Configuração do servidor RPG Play.
# Depois de mudar algo aqui: sudo systemctl restart rpgplay-server

# Nome que aparece nos celulares e no painel do Mestre.
RPG_SERVER_NAME="Mesa de RPG"

# Porta dos celulares e do painel do Mestre (libere no firewall: 8080/tcp).
RPG_PORT=8080

# Descoberta automática na rede Wi-Fi (libere no firewall: 47777/udp).
RPG_DISCOVERY_ENABLED=true

# Depois que todo o grupo criou a conta, mude para false para ninguém mais se cadastrar.
RPG_ALLOW_REGISTRATION=true

# Banco de dados, imagens e chaves. Backup: sudo rpgplay-server backup ~/rpgplay-backup.tar.gz
RPG_DATA_DIR=/var/lib/rpgplay

RPG_ENV=prod
