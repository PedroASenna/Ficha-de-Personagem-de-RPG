# Copie para .env (nunca versione o .env).
RPG_ENV=dev
RPG_DATABASE_URL=postgresql+asyncpg://rpg:rpg@localhost:5432/rpg
RPG_REDIS_URL=redis://localhost:6379/0
# Em produção: valor longo e aleatório vindo do Secret Manager.
RPG_JWT_SECRET=troque-por-um-segredo-longo
RPG_MEDIA_BACKEND=local
RPG_MEDIA_LOCAL_DIR=./media
