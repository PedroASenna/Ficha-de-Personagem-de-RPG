# Copie para .env (nunca versione o .env). No servidor instalado pelo .deb a config fica em
# /etc/rpgplay/server.env, com as mesmas variáveis.
RPG_ENV=dev
RPG_SERVER_NAME=Mesa de RPG
RPG_PORT=8080
# Banco, mídia, segredo JWT e id do servidor ficam aqui (SQLite por padrão).
RPG_DATA_DIR=./data
# Depois de criar as contas do grupo, feche o cadastro:
# RPG_ALLOW_REGISTRATION=false
# Descoberta na rede (UDP 47777) para os apps acharem o servidor sozinhos.
RPG_DISCOVERY_ENABLED=true

# Opcional: Postgres e Redis no lugar do SQLite e do broadcaster em memória.
# RPG_DATABASE_URL=postgresql+asyncpg://rpg:rpg@localhost:5432/rpg
# RPG_REDIS_URL=redis://localhost:6379/0
